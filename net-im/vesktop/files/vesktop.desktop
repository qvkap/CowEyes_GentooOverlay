[Desktop Entry]
Name=Vesktop
Comment=Vencord Desktop is a free/libre cross platform desktop app aiming to give you a snappier Discord experience with Vencord pre-installed
GenericName=Internet Messenger
Type=Application
Exec=/usr/bin/vesktop --enable-features=UseOzonePlatform,WaylandWindowDecorations,WebRTCPipeWireCapturer --ozone-platform=wayland %U
Icon=vesktop-bin
Categories=Network;InstantMessaging;Chat;
StartupWMClass=vesktop
Keywords=discord;vencord;electron;chat;
MimeType=x-scheme-handler/discord;
